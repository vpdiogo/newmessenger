# Copy to .env.backup, chmod 600, and configure outside Git.
RESTIC_REPOSITORY=s3:https://REPLACE_ACCOUNT.r2.cloudflarestorage.com/REPLACE_BUCKET/newmessenger
# Generate independently: openssl rand -hex 32. Keep a recovery copy off the VPS.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Repository data estimate, not total billed R2 account/bucket storage.
BACKUP_WARNING_BYTES=8000000000
