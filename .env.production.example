# Copy to .env.production and chmod 600. Generate each secret separately:
# openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# Initialization settings: do not change these for an existing database volume.
POSTGRES_DB=newmessenger
APP_DB_USER=newmessenger

# Set images to the same verified release, preferably @sha256:...
API_IMAGE=ghcr.io/vpdiogo/newmessenger-api:REPLACE_WITH_COMMIT
WEB_IMAGE=ghcr.io/vpdiogo/newmessenger-web:REPLACE_WITH_COMMIT
MIGRATION_IMAGE=ghcr.io/vpdiogo/newmessenger-migrate:REPLACE_WITH_COMMIT
BACKUP_IMAGE=ghcr.io/vpdiogo/newmessenger-backup:REPLACE_WITH_COMMIT

CORS_ORIGIN=https://newmessenger-app.duckdns.org
PROXY_NETWORK=proxy
HTTP_WRITE_RATE_LIMIT_ENABLED=false
WEBSOCKET_CONNECTION_LIMIT_ENABLED=false
